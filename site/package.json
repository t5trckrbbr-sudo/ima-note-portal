{
  "name": "ima-outlook-2027",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check public/app.js && node --check public/details.js && node --check public/nim.js && node --check public/qa.js && node --check worker/api.js && node --check worker/reviews.js && node --check worker/review-model.js && node --check scripts/review-queue.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run build && node scripts/dev.mjs",
    "review:prepare": "node --use-env-proxy scripts/review-queue.mjs prepare",
    "review:apply": "node --use-env-proxy scripts/review-queue.mjs apply",
    "review:verify": "node --use-env-proxy scripts/review-queue.mjs verify"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "esbuild": "0.25.12"
  },
  "engines": {
    "node": ">=24"
  }
}
